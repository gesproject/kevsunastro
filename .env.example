# Public GitHub App identifier. Set this in the production environment only after
# the client creates or reuses the GitHub App authorised for gesproject/kevsunastro.
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Keep these values only in the local private .env file and the Cloudflare secret
# manager. Never commit, print, or expose them to the public site.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
