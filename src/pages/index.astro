---
export const prerender = true;

import { getSite, getPlatformLinks } from "../lib/content";
import { musicGroupJsonLd } from "../lib/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Music from "../components/Music.astro";
import Shows from "../components/Shows.astro";
import Footer from "../components/Footer.astro";

const site = await getSite();
const socialLinks = (await getPlatformLinks())
  .filter((link) => link.data.kind === "social" && "href" in link.data)
  .map((link) => ({ label: link.data.label, href: link.data.href as string }));
const structuredData = musicGroupJsonLd({
  origin: Astro.site?.toString() ?? "",
  artistName: site.data.artistName,
  description: site.data.description,
  location: site.data.location,
  profileImage: site.data.profileImage,
  socialLinks,
});
---

<BaseLayout
  title={site.data.artistName}
  description={site.data.description}
  socialImage="/images/og-card.jpg"
  structuredData={structuredData}
>
  <Hero />
  <Music />
  <Shows />
  <Footer />
</BaseLayout>

<script>
  import { initHeroSequence } from "../lib/motion/heroSequence";
  import { initMusicTimeline } from "../lib/motion/musicTimeline";
  import { initShowsTimeline } from "../lib/motion/showsTimeline";
  import { initFooterTimeline } from "../lib/motion/footerTimeline";
  import { initFooterWaves } from "../lib/motion/footerWaves";
  initHeroSequence();
  initMusicTimeline();
  initShowsTimeline();
  initFooterTimeline();
  initFooterWaves();
</script>
