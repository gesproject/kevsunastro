---
/**
 * Task 3.3 — Footer section: booking/social structure, watermark, and the
 * static wave host. The entrance timeline (booking/link stagger, mobile
 * scrub-in) belongs to Task 4.3; the interactive wave field belongs to
 * Task 4.4. Everything here must be readable with JavaScript off.
 */
import { getPlatformLinks, getSite } from "../lib/content";

const [platformLinks, site] = await Promise.all([getPlatformLinks(), getSite()]);

// ponytail: computed once at build time on this prerendered route, so it
// freezes until the next deploy instead of self-correcting like legacy's
// client-side call did. Upgrade path if a missed Jan 1 rollover ever
// matters: a one-line inline script, or move this route off full prerender.
const year = new Date().getFullYear();
---

<footer class="footer safe-bottom" id="footer">
  <!-- Task 4.4 mounts a decorative canvas here after JavaScript boots. -->
  <div class="footer__waves" aria-hidden="true"></div>

  <div class="footer__watermark footer__watermark--desktop" aria-hidden="true">
    <span>SÖLBO</span>
  </div>
  <div class="footer__watermark footer__watermark--mobile" aria-hidden="true">
    <span>SÖLBO</span>
  </div>

  <div class="footer__content">
    <div class="footer__booking">
      <p class="footer__booking-label">Booking / Inquiries</p>
      <a class="footer__booking-email" href={`mailto:${site.data.bookingEmail}`}>
        {site.data.bookingEmail}
      </a>
    </div>

    <div class="footer__links">
      {
        platformLinks.map((link) =>
          link.data.enabled ? (
            <a href={link.data.href} target="_blank" rel="noopener noreferrer">
              {link.data.label}
            </a>
          ) : (
            <span class="footer__link--pending">{link.data.label}</span>
          ),
        )
      }
      <span class="footer__copyright">&copy; {year} {site.data.artistName}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    --footer-text: #e8e0d4;
    --footer-watermark: #dee0de;

    position: relative;
    display: flex;
    overflow: hidden;
    min-height: 44vh;
    flex-direction: column;
    justify-content: flex-end;
  }

  .footer__waves {
    position: absolute;
    z-index: var(--z-base);
    inset: 0;
    pointer-events: none;
  }

  .footer__watermark {
    position: absolute;
    z-index: var(--z-base);
    overflow: hidden;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .footer__watermark span {
    display: block;
    color: var(--footer-watermark);
    font-weight: 900;
    opacity: 0.5;
    white-space: nowrap;
  }

  .footer__watermark--desktop {
    display: none;
  }

  .footer__watermark--mobile {
    inset: 0 auto 0 0;
    width: 1em;
    margin-left: -5vw;
    font-size: clamp(7.6rem, 15vw, 12rem);
    writing-mode: vertical-lr;
  }

  .footer__watermark--mobile span {
    letter-spacing: -0.05em;
  }

  .footer__content {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 5vw, 5rem) clamp(1.75rem, 3vw, 3rem);
  }

  .footer__booking {
    display: flex;
    justify-content: flex-end;
    /* Legacy: mb-15 md:mb-55 (Tailwind v4, 0.25rem step) = 3.75rem / 13.75rem.
       No token in the space scale is close to either value. */
    margin-bottom: 3.75rem;
    text-align: right;
  }

  .footer__booking-label {
    margin: 0 0 0.4rem;
    color: var(--footer-text);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.4em;
    opacity: 0.3;
    text-transform: uppercase;
  }

  .footer__booking-email {
    color: var(--footer-text);
    font-family: var(--font-mono);
    font-size: clamp(0.88rem, 2vw, 1.5rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    opacity: 0.65;
    text-decoration: none;
    transition: opacity var(--duration-base) var(--ease-in-out);
  }

  .footer__booking-email:hover,
  .footer__booking-email:focus-visible {
    opacity: 1;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-4) var(--space-5);
  }

  .footer__links a,
  .footer__link--pending {
    color: var(--footer-text);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .footer__links a {
    opacity: 0.38;
    transition: opacity var(--duration-base) var(--ease-in-out);
  }

  .footer__links a:hover,
  .footer__links a:focus-visible {
    opacity: 0.9;
  }

  .footer__link--pending {
    opacity: 0.2;
  }

  .footer__copyright {
    color: var(--footer-text);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    opacity: 0.14;
    text-transform: uppercase;
  }

  /* A focused link takes priority over the decorative entrance state. */
  .footer:focus-within .footer__content,
  .footer:focus-within .footer__booking,
  .footer:focus-within .footer__links a,
  .footer:focus-within .footer__link--pending {
    opacity: 1 !important;
    transform: none !important;
  }

  @media (width >= 768px) {
    .footer__watermark--desktop {
      display: block;
      /* left:0 AND right:0 pinned with width left auto (no width here) makes the
         box absorb margin-left into its own width instead of just sliding both
         edges — right edge stays flush with the footer, left edge grows past it
         and gets clipped. That's what reproduces legacy's nested auto-width div;
         adding an explicit width here would shift the right edge inward instead. */
      inset: auto 0 0 0;
      max-height: 0.7em;
      margin-left: -6vw;
      font-size: clamp(5rem, 25vw, 20rem);
      line-height: 0.9;
    }

    .footer__watermark--desktop span {
      letter-spacing: -0.07em;
    }

    .footer__watermark--mobile {
      display: none;
    }

    .footer__links {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
    }

    .footer__copyright {
      margin-inline-start: auto;
    }

    .footer__booking {
      margin-bottom: 13.75rem;
    }
  }
</style>
