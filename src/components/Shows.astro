---
/**
 * Task 3.2 — Shows section, static markup and vanilla CSS only.
 * ScrollTrigger reveals and per-row text-scramble on hover belong to
 * Task 4.3 (showsTimeline.ts). Everything here must be readable with
 * JavaScript off.
 *
 * Minimalist rework (2026-08-22, pass 3):
 * - The glass "signal board" chrome is gone — rows sit directly on the
 *   section's waves-shader backdrop as bare typographic rows.
 * - All micro-labels removed (board meta/foot, gallery captions): the
 *   section speaks only through dates, venues, cities and status.
 * - The sticky desktop photo panel is retired (its clip-under-gallery bug
 *   was the repo's longest-lived ponytail); photography now lives in an
 *   infinite marquee strip at the foot of the section.
 */
import { getShows } from "../lib/content";

type ShowRow = {
  date: string;
  venue: string;
  city: string;
  status: "available" | "sold-out" | "free" | "demo";
  ticketUrl?: string;
};

const contentShows = await getShows();
const shows: ShowRow[] = contentShows.map(({ data }) => ({
  date: data.date,
  venue: data.venue,
  city: data.city,
  status: data.status,
  ticketUrl: data.ticketUrl,
}));

function formatShowDate(iso: string) {
  return `${iso.slice(8, 10)} · ${iso.slice(5, 7)} · ${iso.slice(0, 4)}`;
}
function getDateParts(iso: string) {
  const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
  return { day: iso.slice(8, 10), month: months[Number(iso.slice(5, 7)) - 1], year: iso.slice(0, 4) };
}

const GALLERY = [
  { src: "/images/shows/live-01.webp", alt: "Sölbo on stage, studio portrait" },
  { src: "/images/shows/live-02.webp", alt: "Sölbo portrait in daylight" },
  { src: "/images/shows/live-03.webp", alt: "Sölbo under stage light" },
  { src: "/images/shows/live-04.webp", alt: "Sölbo performing live, wide shot" },
];
---

<section class="shows" id="shows">
  <div class="shows__seam" aria-hidden="true"></div>
  <div class="shows__backdrop" aria-hidden="true">
    <canvas data-shows-shader></canvas>
    <div class="shows__backdrop-veil"></div>
  </div>

  <div class="shows__inner">
    <div class="shows__header">
      <h2>Find me live.</h2>
    </div>

    <ul class="shows__list" role="list">
      {
        shows.map((show) => {
          const date = getDateParts(show.date);
          return (
            <li class="shows__row">
              <time class="shows__date" datetime={show.date} aria-label={formatShowDate(show.date)}>
                <span class="shows__date-day shows__date-label">{date.day}</span>
                <span class="shows__date-month">{date.month}</span>
                <span class="shows__date-year">{date.year}</span>
              </time>
              <span class="shows__venue">{show.venue}</span>
              <span class="shows__city">{show.city}</span>
              <span class="shows__ticket-cell">
                {show.status === "sold-out" ? (
                  <span class="shows__badge">Sold Out</span>
                ) : show.status === "free" ? (
                  <span class="shows__badge">Free</span>
                ) : show.ticketUrl ? (
                  <a
                    class="shows__ticket"
                    href={show.ticketUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Tickets <span aria-hidden="true">↗</span>
                  </a>
                ) : null}
              </span>
            </li>
          );
        })
      }
    </ul>

    <!--
      Live marquee — an infinite, slow drift of stills. Static markup stays
      a plain list (no-JS reads it top to bottom); the loop is pure CSS
      transform animation over a duplicated track, paused under reduced
      motion, with hover holding the nearest card.
    -->
    <div class="shows__marquee" aria-label="Live photo gallery">
      <div class="shows__marquee-track">
        {[0, 1].map((copy) => (
          <div class="shows__marquee-group" aria-hidden={copy === 1 ? "true" : undefined}>
            {GALLERY.map((photo) => (
              <figure class="shows__gallery-item">
                <img src={photo.src} alt={copy === 0 ? photo.alt : ""} width="800" height="1000" loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .shows {
    --shows-text: #e8e0d4;
    --shows-border: 232 224 212;

    position: relative;
    overflow-x: clip;
  }

  .shows__seam {
    position: absolute;
    z-index: var(--z-base);
    inset: 0 0 auto;
    height: 25vh;
    background: linear-gradient(to bottom, var(--color-ink) 0%, transparent 100%);
    pointer-events: none;
  }

  /* Section-scoped mount of the shared WebGL engine with the human-supplied
     waves shader (see shaders/waves.ts). Same contract as /link's Plasma:
     no-WebGL floor below stands in when the canvas never paints. */
  .shows__backdrop {
    position: absolute;
    z-index: var(--z-base);
    inset: 0;
    background:
      radial-gradient(ellipse at 24% 18%, rgb(88 60 168 / 16%) 0%, transparent 55%),
      radial-gradient(ellipse at 78% 72%, rgb(6 5 14 / 70%) 0%, transparent 55%),
      #07050f;
    pointer-events: none;
  }

  .shows__backdrop canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .shows__backdrop canvas[data-ready] {
    opacity: 1;
  }

  /* Dark veil measured against the shader's brightest stop (violet ~rgb(145,
     107, 191)): at 55% ink that worst case lands ~rgb(65,48,86); the row text
     (#e8e0d4) holds >7:1 against it. Deepens toward the marquee. */
  .shows__backdrop-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 5 14 / 50%) 0%, rgb(6 5 14 / 55%) 55%, rgb(6 5 14 / 75%) 100%);
  }

  .shows__inner {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-7) var(--page-gutter) var(--space-7)
      calc(var(--page-gutter) + var(--safe-left));
    padding-right: calc(var(--page-gutter) + var(--safe-right));
  }

  .shows__header {
    margin: 0 0 var(--space-5);
  }

  .shows__header h2 {
    margin: 0;
    color: var(--shows-text);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.85;
  }

  /* Bare typographic rows on the shader field — no board chrome. */
  .shows__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shows__row {
    position: relative;
    grid-template-columns: 4.75rem minmax(0, 1fr) auto;
    grid-template-areas:
      "date venue action"
      "date city action";
    gap: 0 0.75rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid rgb(var(--shows-border) / 12%);
    transition:
      border-color var(--duration-base) var(--ease-in-out),
      background-color var(--duration-base) var(--ease-in-out);
  }

  .shows__row::before {
    position: absolute;
    inset: 0.45rem auto 0.45rem 0;
    width: 2px;
    background: rgb(222 250 103 / 65%);
    content: "";
    opacity: 0;
    transform: scaleY(0.25);
    transition:
      opacity var(--duration-base) var(--ease-in-out),
      transform var(--duration-base) var(--ease-in-out);
  }

  .shows__row:hover,
  .shows__row:focus-within {
    border-color: transparent;
    background: rgb(222 250 103 / 5%);
  }

  .shows__row:hover::before,
  .shows__row:focus-within::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .shows__date {
    display: grid;
    grid-area: date;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    column-gap: 0.3rem;
    align-items: end;
    align-self: stretch;
    color: var(--shows-text);
    font-family: var(--font-mono);
    line-height: 0.9;
    opacity: 0.95;
  }

  .shows__date-day {
    grid-row: span 2;
    font-size: clamp(1.9rem, 6vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.1em;
  }

  .shows__date-month,
  .shows__date-year {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    opacity: 0.62;
  }

  .shows__venue {
    grid-area: venue;
    color: var(--shows-text);
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .shows__city {
    grid-area: city;
    margin-top: 0.15rem;
    color: var(--shows-text);
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .shows__ticket-cell {
    display: inline-flex;
    grid-area: action;
    align-items: center;
  }

  .shows__badge {
    padding: 0.28rem 0.7rem;
    border: 1px solid rgb(var(--shows-border) / 22%);
    border-radius: 999px;
    color: var(--shows-text);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }

  .shows__row:hover .shows__badge {
    border-color: rgb(222 250 103 / 40%);
    opacity: 1;
  }

  .shows__ticket {
    color: var(--shows-text);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .shows__ticket span {
    color: rgb(222 250 103 / 90%);
  }

  .shows__ticket:hover span {
    color: rgb(222 250 103 / 100%);
  }

  /* A focused ticket must reveal its row immediately, even before the
     entrance/exit scrub has reached its opaque state. */
  .shows:focus-within .shows__header h2,
  .shows:focus-within .shows__row {
    opacity: 1 !important;
    transform: none !important;
  }

  .shows:focus-within .shows__header h2 {
    clip-path: none !important;
  }

  /* ── Live marquee ── */

  .shows__marquee {
    overflow: hidden;
    margin-top: var(--space-7);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .shows__marquee-track {
    display: flex;
    width: max-content;
  }

  .shows__marquee-group {
    display: flex;
    gap: 0.6rem;
    padding-right: 0.6rem;
    animation: shows-marquee 42s linear infinite;
  }

  @keyframes shows-marquee {
    to {
      transform: translateX(-100%);
    }
  }

  .shows__marquee:hover .shows__marquee-group {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .shows__marquee-group {
      animation: none;
    }
  }

  .shows__gallery-item {
    flex-shrink: 0;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgb(var(--shows-border) / 12%);
    border-radius: 0.35rem;
  }

  .shows__gallery-item img {
    display: block;
    width: clamp(150px, 18vw, 230px);
    height: clamp(188px, 22.5vw, 288px);
    object-fit: cover;
    transition: transform 600ms var(--ease-out-expo), border-color var(--duration-base) var(--ease-in-out);
  }

  .shows__marquee:hover .shows__gallery-item:hover img {
    transform: scale(1.03);
  }

  @media (min-width: 768px) {
    .shows__inner {
      padding-top: var(--space-8);
      padding-bottom: calc(var(--space-8) * 3);
    }

    .shows__list {
      max-width: 62rem;
    }

    .shows__row {
      grid-template-columns: 5.4rem minmax(0, 1fr) minmax(6rem, 0.35fr) auto;
      grid-template-areas: "date venue city action";
      align-items: center;
      padding: 0.7rem 0.5rem;
    }

    .shows__venue {
      font-size: clamp(1.2rem, 1.9vw, 1.7rem);
    }

    .shows__city {
      justify-self: start;
      margin-top: 0;
    }
  }
</style>
