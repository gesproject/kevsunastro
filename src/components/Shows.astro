---
/**
 * Task 3.2 — Shows section, static markup and vanilla CSS only.
 * ScrollTrigger reveals and per-row text-scramble on hover belong to
 * Task 4.3 (showsTimeline.ts). Everything here must be readable with
 * JavaScript off.
 *
 * Minimalist rework (2026-08-22, pass 3):
 * - The glass "signal board" chrome is gone — rows sit directly on the
 *   section's waves-shader backdrop as bare typographic rows.
 *
 * Cinematic carousel rework (2026-08-23):
 * - The single flat marquee is replaced by a dual counter-scrolling strip:
 *   two rows drifting in opposite directions at different speeds on slightly
 *   opposed 3D tilts, edge-masked so both dissolve into the shader field.
 * - The section's foot now bleeds into Footer: padding collapses and a
 *   shared gradient band carries the strips' bottom edge into the footer's
 *   wave field instead of ending on a hard line.
 * - Row spacing opened up (--space-2 rhythm, taller rows) per review note
 *   "everything is cramped out — give all elements some space to breathe".
 *
 * Polish pass (2026-08-23, pass 4):
 * - Rows breathe again: --space-2 rhythm between rows, taller padding, and
 *   an explicit min gap so location never crowds the ticket/badge column —
 *   measured 14px city→action on mobile, ~175–260px of dead air on desktop.
 * - The desktop counterweight portrait now enters at 1024px instead of
 *   1200px: at common laptop widths the right field was completely empty
 *   with the list stretched full-width.
 *
 * Polish pass (2026-08-23, pass 5):
 * - Right rail became the live-reel video placeholder (poster + play glyph,
 *   3:2, larger column) per review "put a video placeholder so I can have a
 *   video there". Swap the img for a <video> when the reel exists.
 * - Sticky removed from that rail: with a five-row schedule it never engaged
 *   and clipped against the stage edge mid-scroll.
 * - Row padding reverted to the pass-3 rhythm ("replace the location, date
 *   and position more close together like it was"); the action-cell standoff
 *   and city measure from pass 4 stay.
 */
import { getShows } from "../lib/content";

type ShowRow = {
  date: string;
  venue: string;
  city: string;
  status: "available" | "sold-out" | "free" | "demo";
  ticketUrl?: string;
};

const contentShows = await getShows();
const shows: ShowRow[] = contentShows.map(({ data }) => ({
  date: data.date,
  venue: data.venue,
  city: data.city,
  status: data.status,
  ticketUrl: data.ticketUrl,
}));

function formatShowDate(iso: string) {
  return `${iso.slice(8, 10)} · ${iso.slice(5, 7)} · ${iso.slice(0, 4)}`;
}
function getDateParts(iso: string) {
  const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
  return { day: iso.slice(8, 10), month: months[Number(iso.slice(5, 7)) - 1], year: iso.slice(0, 4) };
}

// Local, art-directed photography only — no third-party image hosts.
const PHOTOS = [
  { src: "/images/shows/live-01.webp", alt: "Sölbo on stage, studio portrait" },
  { src: "/images/shows/live-02.webp", alt: "Sölbo portrait in daylight" },
  { src: "/images/shows/live-03.webp", alt: "Sölbo under stage light" },
  { src: "/images/shows/live-04.webp", alt: "Sölbo performing live, wide shot" },
  { src: "/images/Horizontal1.webp", alt: "Sölbo horizontal editorial still" },
  { src: "/images/solbo-profile.jpg", alt: "Sölbo profile portrait" },
  { src: "/images/player-art.webp", alt: "Sölbo player artwork" },
  { src: "/images/artwork-threshold.webp", alt: "Threshold release artwork" },
];

// Split across two strips; each strip duplicates its half for a seamless loop.
const TOP_STRIP = [PHOTOS[0], PHOTOS[2], PHOTOS[4], PHOTOS[6]];
const BOTTOM_STRIP = [PHOTOS[1], PHOTOS[3], PHOTOS[5], PHOTOS[7]];
---

<section class="shows" id="shows">
  <div class="shows__seam" aria-hidden="true"></div>
  <div class="shows__backdrop" aria-hidden="true">
    <canvas data-shows-shader></canvas>
    <div class="shows__backdrop-veil"></div>
  </div>

  <div class="shows__inner">
    <div class="shows__stage">
      <div class="shows__schedule">
        <div class="shows__header">
          <h2>Find me live.</h2>
        </div>

        <ul class="shows__list" role="list">
          {
            shows.map((show) => {
              const date = getDateParts(show.date);
              return (
                <li class="shows__row">
                  <time class="shows__date" datetime={show.date} aria-label={formatShowDate(show.date)}>
                    <span class="shows__date-day shows__date-label">{date.day}</span>
                    <span class="shows__date-month">{date.month}</span>
                    <span class="shows__date-year">{date.year}</span>
                  </time>
                  <span class="shows__venue">{show.venue}</span>
                  <span class="shows__city">{show.city}</span>
                  <span class="shows__ticket-cell">
                    {show.status === "sold-out" ? (
                      <span class="shows__badge">Sold Out</span>
                    ) : show.status === "free" ? (
                      <span class="shows__badge">Free</span>
                    ) : show.ticketUrl ? (
                      <a
                        class="shows__ticket"
                        href={show.ticketUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Tickets <span aria-hidden="true">↗</span>
                      </a>
                    ) : null}
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- Desktop counterweight: the live-reel video slot. Poster + play glyph
           now; swap the img for a <video src controls> when the reel lands. -->
      <figure class="shows__video">
        <img
          src="/images/shows/live-02.webp"
          alt="Sölbo performing live"
          width="800"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <span class="shows__video-play" aria-hidden="true"></span>
      </figure>
    </div>

    <!--
      Dual live strips — two infinite drifts in opposite directions at
      different speeds, each on its own slight 3D tilt. Static markup stays
      plain duplicated lists (no-JS reads them top to bottom); the loops are
      pure CSS transform animations over duplicated tracks, paused under
      reduced motion, with hover holding the nearest card.
    -->
    <div class="shows__strips" aria-label="Live photo gallery">
      <div class="shows__strip shows__strip--top">
        <div class="shows__strip-track">
          {[0, 1].map((copy) => (
            <div class="shows__strip-group" aria-hidden={copy === 1 ? "true" : undefined}>
              {TOP_STRIP.map((photo) => (
                <figure class="shows__gallery-item">
                  <img src={photo.src} alt={copy === 0 ? photo.alt : ""} width="800" height="1000" loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="shows__strip shows__strip--bottom">
        <div class="shows__strip-track">
          {[0, 1].map((copy) => (
            <div class="shows__strip-group shows__strip-group--reverse" aria-hidden={copy === 1 ? "true" : undefined}>
              {BOTTOM_STRIP.map((photo) => (
                <figure class="shows__gallery-item shows__gallery-item--wide">
                  <img src={photo.src} alt={copy === 0 ? photo.alt : ""} width="800" height="1000" loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Shared foot band: carries the strips into the footer's wave field. -->
  <div class="shows__foot-fade" aria-hidden="true"></div>
</section>

<style>
  .shows {
    --shows-text: #e8e0d4;
    --shows-border: 232 224 212;

    position: relative;
    overflow-x: clip;
  }

  /* Music→Shows seam: a long colour hand-off. Music's own exit ramp now
     arrives already carrying this section's violet (its .music__seam ends on
     #07050f), so the gradient below only has to deepen the same tone — the
     hand-off reads as one continuous descent rather than a hue cut. The old
     hairline "horizon" is retired: at the new softness it read as a visible
     horizontal rule instead of atmosphere. Both layers sit above the
     backdrop so they read even before WebGL paints. */
  .shows__seam {
    position: absolute;
    /* The backdrop follows this element in the DOM. This higher layer lets
       the hand-off actually grade over that field rather than sit beneath it. */
    z-index: var(--z-content);
    inset: 0 0 auto;
    height: 44svh;
    background: linear-gradient(
      to bottom,
      #07050f 0%,
      rgb(7 5 15 / 88%) 30%,
      rgb(9 7 18 / 48%) 62%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* Section-scoped mount of the shared WebGL engine with the human-supplied
     waves shader (see shaders/waves.ts). Same contract as /link's Plasma:
     no-WebGL floor below stands in when the canvas never paints. */
  .shows__backdrop {
    position: absolute;
    z-index: var(--z-base);
    inset: 0;
    background:
      radial-gradient(ellipse at 24% 18%, rgb(88 60 168 / 16%) 0%, transparent 55%),
      radial-gradient(ellipse at 78% 72%, rgb(6 5 14 / 70%) 0%, transparent 55%),
      #07050f;
    pointer-events: none;
  }

  .shows__backdrop canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  .shows__backdrop canvas[data-ready] {
    opacity: 1;
  }

  /* Dark veil measured against the shader's brightest stop (violet ~rgb(145,
     107, 191)): at 55% ink that worst case lands ~rgb(65,48,86); the row text
     (#e8e0d4) holds >7:1 against it. Deepens toward the strips, then the very
     foot relaxes — the footer's wave field takes over from there. */
  .shows__backdrop-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 5 14 / 50%) 0%, rgb(6 5 14 / 55%) 55%, rgb(6 5 14 / 75%) 92%, rgb(6 5 14 / 40%) 100%);
  }

  .shows__inner {
    position: relative;
    z-index: var(--z-content);
    padding: var(--space-7) var(--page-gutter) var(--space-7)
      calc(var(--page-gutter) + var(--safe-left));
    padding-right: calc(var(--page-gutter) + var(--safe-right));
  }

  .shows__header {
    margin: 0 0 var(--space-6);
  }

  .shows__header h2 {
    margin: 0;
    color: var(--shows-text);
    font-size: clamp(1.5rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.85;
  }

  .shows__stage {
    position: relative;
  }

  .shows__video {
    display: none;
  }

  /* Bare typographic rows on the shader field — no board chrome. Spacing
     opened up: taller rows, more air between list and header. */
  .shows__list {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shows__row {
    display: grid;
    position: relative;
    grid-template-columns: 4.75rem minmax(0, 1fr) auto;
    grid-template-areas:
      "date venue action"
      "date city action";
    gap: 0.35rem 0.9rem;
    padding: 1.15rem 0.85rem;
    border-bottom: 1px solid rgb(var(--shows-border) / 12%);
    transition:
      border-color var(--duration-base) var(--ease-in-out),
      background-color var(--duration-base) var(--ease-in-out);
  }

  .shows__row::before {
    position: absolute;
    inset: 0.45rem auto 0.45rem 0;
    width: 2px;
    background: rgb(222 250 103 / 65%);
    content: "";
    opacity: 0;
    transform: scaleY(0.25);
    transition:
      opacity var(--duration-base) var(--ease-in-out),
      transform var(--duration-base) var(--ease-in-out);
  }

  .shows__row:hover,
  .shows__row:focus-within {
    border-color: transparent;
    background: rgb(222 250 103 / 5%);
  }

  .shows__row:hover::before,
  .shows__row:focus-within::before {
    opacity: 1;
    transform: scaleY(1);
  }

  .shows__date {
    display: grid;
    grid-area: date;
    grid-template-columns: auto 1fr;
    grid-template-rows: 1fr auto;
    column-gap: 0.3rem;
    align-items: end;
    align-self: stretch;
    color: var(--shows-text);
    font-family: var(--font-mono);
    line-height: 0.9;
    opacity: 0.95;
  }

  .shows__date-day {
    grid-row: span 2;
    font-size: clamp(1.9rem, 6vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.1em;
  }

  .shows__date-month,
  .shows__date-year {
    font-size: 0.56rem;
    letter-spacing: 0.14em;
    opacity: 0.62;
  }

  .shows__venue {
    grid-area: venue;
    color: var(--shows-text);
    font-size: clamp(1.15rem, 1.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .shows__city {
    grid-area: city;
    margin-top: 0.15rem;
    color: var(--shows-text);
    font-size: 0.8rem;
    opacity: 0.6;
  }

  .shows__ticket-cell {
    display: inline-flex;
    grid-area: action;
    align-items: center;
    justify-self: end;
    /* Guaranteed breathing room between the location and the action, no
       matter how the city/venue columns resolve — the measured 14px mobile
       gap lived here. */
    margin-left: 1.75rem;
  }

  .shows__badge {
    padding: 0.28rem 0.7rem;
    border: 1px solid rgb(var(--shows-border) / 22%);
    border-radius: 999px;
    color: var(--shows-text);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }

  .shows__row:hover .shows__badge {
    border-color: rgb(222 250 103 / 40%);
    opacity: 1;
  }

  .shows__ticket {
    color: var(--shows-text);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .shows__ticket span {
    color: rgb(222 250 103 / 90%);
  }

  .shows__ticket:hover span {
    color: rgb(222 250 103 / 100%);
  }

  /* A focused ticket must reveal its row immediately, even before the
     entrance/exit scrub has reached its opaque state. */
  .shows:focus-within .shows__header h2,
  .shows:focus-within .shows__row {
    opacity: 1 !important;
    transform: none !important;
  }

  .shows:focus-within .shows__header h2 {
    clip-path: none !important;
  }

  /* ── Dual live strips ──
     Two counter-drifting rows on opposed slight tilts. Perspective lives on
     the wrapper; each track's rotateX pushes its far edge back, so together
     they read like one dense cinematic field rather than two lists. */

  .shows__strips {
    perspective: 900px;
    overflow: hidden;
    margin-top: var(--space-8);
    /* Full-bleed past the inner gutters: strips run edge-to-edge while the
       rows above stay inside the page measure. */
    margin-inline: calc(-1 * var(--page-gutter));
  }

  .shows__strip {
    overflow: hidden;
    padding-block: 0.75rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  /* Top strip: tilted away at its top edge, drifting left. */
  .shows__strip--top .shows__strip-track {
    transform: rotateX(7deg);
  }

  /* Bottom strip: mirrored tilt, drifting right, slightly larger cards —
     the parallax between speeds + sizes is what makes it feel deep. */
  .shows__strip--bottom {
    margin-top: -0.25rem;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 18%, #000 100%);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent),
      linear-gradient(to bottom, transparent, #000 18%, #000 100%);
  }

  .shows__strip--bottom .shows__strip-track {
    transform: rotateX(-6deg);
  }

  .shows__strip-track {
    display: flex;
    width: max-content;
    transform-style: preserve-3d;
  }

  .shows__strip-group {
    display: flex;
    gap: clamp(0.9rem, 2vw, 1.5rem);
    padding-right: clamp(0.9rem, 2vw, 1.5rem);
    animation: shows-marquee-left 52s linear infinite;
  }

  .shows__strip-group--reverse {
    animation-name: shows-marquee-right;
    animation-duration: 64s;
  }

  @keyframes shows-marquee-left {
    to {
      transform: translateX(-100%);
    }
  }

  @keyframes shows-marquee-right {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .shows__strips:hover .shows__strip-group {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .shows__strip-group {
      animation: none;
    }

    .shows__strip--top .shows__strip-track,
    .shows__strip--bottom .shows__strip-track {
      transform: none;
    }
  }

  .shows__gallery-item {
    flex-shrink: 0;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgb(var(--shows-border) / 12%);
    border-radius: 0.5rem;
    box-shadow: 0 18px 42px -18px rgb(0 0 0 / 80%);
  }

  .shows__gallery-item img {
    display: block;
    width: clamp(170px, 21vw, 280px);
    height: clamp(212px, 26vw, 350px);
    object-fit: cover;
    transition: transform 600ms var(--ease-out-expo), filter 600ms var(--ease-out-expo);
  }

  /* Bottom strip runs wider-format cards for the size parallax. */
  .shows__gallery-item--wide img {
    width: clamp(210px, 27vw, 360px);
    height: clamp(180px, 22vw, 300px);
  }

  .shows__gallery-item:hover img,
  .shows__gallery-item:focus-within img {
    filter: brightness(1.08);
    transform: scale(1.04);
  }

  /* Shows→Footer merge: the section's own foot fades out over the last
     viewport of travel instead of ending on a hard boundary. The band sits
     outside __inner (full-bleed) and its ink tint matches the footer waves'
     ground so the two fields read as one continuous surface. */
  .shows__foot-fade {
    position: relative;
    z-index: var(--z-content);
    height: 22svh;
    background: linear-gradient(to bottom, transparent 0%, rgb(6 5 14 / 55%) 55%, var(--color-ink) 100%);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .shows__inner {
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .shows__list {
      max-width: 62rem;
    }

    .shows__row {
      grid-template-columns: 5.4rem minmax(0, 1fr) minmax(9rem, 0.34fr) minmax(7.5rem, max-content);
      grid-template-areas: "date venue city action";
      column-gap: clamp(1.25rem, 2vw, 2rem);
      align-items: center;
      padding: 1.15rem 0.85rem;
    }

    .shows__venue {
      font-size: clamp(1.2rem, 1.9vw, 1.7rem);
    }

    /* The city keeps its own measure; the action cell holds a fixed minimum,
       so location→ticket spacing stays deliberate instead of collapsing or
       ballooning between them. */
    .shows__city {
      justify-self: start;
      margin-top: 0;
      padding-right: 2.5rem;
      box-decoration-break: clone;
    }
  }

  /* The schedule keeps its full measure through tablet. From 1024px — common
     laptop width, where the right field previously sat empty with the list
     stretched wide — the live-reel video slot balances the schedule without
     duplicating the mobile gallery treatment. No sticky: a five-row list is
     barely taller than the media box, so sticky never engaged and instead
     clipped the box against the stage edge mid-scroll (reported 2026-08-23). */
  @media (min-width: 1024px) {
    .shows__stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(20rem, 28vw, 28rem);
      gap: clamp(2.5rem, 4vw, 5rem);
      align-items: start;
    }

    .shows__list {
      max-width: none;
    }

    /* Live-reel slot, sized like a video frame (3:2) and notably larger than
       the old portrait. Static markup only — no JS until a real <video>
       replaces the poster. */
    .shows__video {
      display: block;
      position: relative;
      margin: 0;
      overflow: hidden;
      border: 1px solid rgb(var(--shows-border) / 18%);
      border-radius: 0.75rem;
      background: #0a0913;
      box-shadow: 0 28px 70px -32px rgb(0 0 0 / 90%);
    }

    .shows__video img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 2;
      object-fit: cover;
      object-position: 62% center;
      filter: saturate(0.84) contrast(1.05);
    }

    .shows__video::after {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to bottom, transparent 55%, rgb(6 5 14 / 56%) 100%),
        linear-gradient(135deg, rgb(116 82 188 / 16%), transparent 55%);
      content: "";
      pointer-events: none;
    }

    .shows__video-play {
      position: absolute;
      left: 50%;
      top: 50%;
      z-index: 1;
      width: clamp(4rem, 6vw, 5.5rem);
      aspect-ratio: 1;
      border: 1px solid rgb(var(--shows-border) / 45%);
      border-radius: 50%;
      background: rgb(10 8 20 / 55%);
      backdrop-filter: blur(6px);
      transform: translate(-50%, -50%);
      transition: transform var(--duration-base) var(--ease-in-out), border-color var(--duration-base) var(--ease-in-out);
    }

    .shows__video-play::after {
      content: "";
      position: absolute;
      left: 54%;
      top: 50%;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 0.7rem 0 0.7rem 1.15rem;
      border-color: transparent transparent transparent rgb(var(--shows-border) / 90%);
      transform: translate(-50%, -50%);
    }

    .shows__video:hover .shows__video-play {
      border-color: rgb(222 250 103 / 60%);
      transform: translate(-50%, -50%) scale(1.06);
    }
  }
</style>
