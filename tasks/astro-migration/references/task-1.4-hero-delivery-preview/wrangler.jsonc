{
  "$schema": "https://unpkg.com/wrangler@4.114.0/config-schema.json",
  "name": "solbo-hero-avif-delivery-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  }
}
