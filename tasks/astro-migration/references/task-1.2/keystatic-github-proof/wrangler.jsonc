{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "solbo-keystatic-github-proof",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "workers_dev": false
}
